{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1200px"
		},
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"duotone": [],
			"palette": [
				{ "slug": "primary", "color": "#00E64D", "name": "Verde Lucas" },
				{ "slug": "primary-dark", "color": "#00A63A", "name": "Verde oscuro" },
				{ "slug": "secondary", "color": "#0A0A0A", "name": "Negro" },
				{ "slug": "bg", "color": "#F4F4F4", "name": "Fondo" },
				{ "slug": "bg-alt", "color": "#EDEDED", "name": "Fondo alterno" },
				{ "slug": "card", "color": "#FFFFFF", "name": "Tarjeta" },
				{ "slug": "border", "color": "#E5E5E5", "name": "Borde" },
				{ "slug": "text", "color": "#0A0A0A", "name": "Texto" },
				{ "slug": "text-muted", "color": "#6B6B6B", "name": "Texto tenue" },
				{ "slug": "success", "color": "#00A63A", "name": "Éxito" },
				{ "slug": "warn", "color": "#E8A200", "name": "Advertencia" },
				{ "slug": "danger", "color": "#D63131", "name": "Error" }
			]
		},
		"typography": {
			"customFontSize": false,
			"dropCap": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Montserrat",
					"fontFamily": "\"Montserrat\", ui-sans-serif, system-ui, sans-serif"
				},
				{
					"slug": "cuerpo",
					"name": "Lato",
					"fontFamily": "\"Lato\", ui-sans-serif, system-ui, sans-serif"
				},
				{
					"slug": "mono",
					"name": "Plex Mono",
					"fontFamily": "\"Plex Mono\", ui-monospace, monospace"
				},
				{
					"slug": "pixel",
					"name": "Pixel LI",
					"fontFamily": "\"Pixel LI\", \"Plex Mono\", monospace"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.8125rem", "name": "Chico" },
				{ "slug": "medium", "size": "1rem", "name": "Normal" },
				{ "slug": "large", "size": "1.3125rem", "name": "Grande" },
				{ "slug": "x-large", "size": "2.125rem", "name": "Título" }
			]
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"units": [ "px", "rem", "%" ]
		},
		"border": {
			"radius": true,
			"color": true,
			"style": true,
			"width": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--bg)",
			"text": "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--cuerpo)",
			"fontSize": "1rem",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--text)" },
				":hover": { "color": { "text": "var(--wp--preset--color--primary-dark)" } }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--secondary)",
					"text": "#FFFFFF"
				},
				"border": { "radius": "10px" },
				"typography": { "fontWeight": "600" },
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary)",
						"text": "var(--wp--preset--color--secondary)"
					}
				}
			},
			"h1": { "typography": { "fontFamily": "var(--wp--preset--font-family--sans)", "fontWeight": "600" } },
			"h2": { "typography": { "fontFamily": "var(--wp--preset--font-family--sans)", "fontWeight": "600" } },
			"h3": { "typography": { "fontFamily": "var(--wp--preset--font-family--sans)", "fontWeight": "600" } }
		}
	}
}
