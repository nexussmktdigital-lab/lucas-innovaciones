{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1200px"
		},
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"duotone": [],
			"palette": [
				{
					"slug": "primary",
					"color": "#00E64D",
					"name": "Verde Lucas"
				},
				{
					"slug": "primary-dark",
					"color": "#00A63A",
					"name": "Verde oscuro"
				},
				{
					"slug": "secondary",
					"color": "#0A0A0A",
					"name": "Negro"
				},
				{
					"slug": "bg",
					"color": "#F4F4F4",
					"name": "Fondo"
				},
				{
					"slug": "bg-alt",
					"color": "#EDEDED",
					"name": "Fondo alterno"
				},
				{
					"slug": "card",
					"color": "#FFFFFF",
					"name": "Tarjeta"
				},
				{
					"slug": "border",
					"color": "#E5E5E5",
					"name": "Borde"
				},
				{
					"slug": "text",
					"color": "#0A0A0A",
					"name": "Texto"
				},
				{
					"slug": "text-muted",
					"color": "#6B6B6B",
					"name": "Texto tenue"
				},
				{
					"slug": "success",
					"color": "#00A63A",
					"name": "Éxito"
				},
				{
					"slug": "warn",
					"color": "#E8A200",
					"name": "Advertencia"
				},
				{
					"slug": "danger",
					"color": "#D63131",
					"name": "Error"
				}
			]
		},
		"typography": {
			"customFontSize": false,
			"dropCap": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Space Grotesk",
					"fontFamily": "\"Space Grotesk\", \"Inter\", ui-sans-serif, system-ui, sans-serif"
				},
				{
					"slug": "cuerpo",
					"name": "Inter",
					"fontFamily": "\"Inter\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"
				},
				{
					"slug": "mono",
					"name": "Inter (cifras)",
					"fontFamily": "\"Inter\", ui-sans-serif, system-ui, sans-serif"
				},
				{
					"slug": "pixel",
					"name": "VT323",
					"fontFamily": "\"VT323\", \"Courier New\", monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "Chico"
				},
				{
					"slug": "medium",
					"size": "1rem",
					"name": "Normal"
				},
				{
					"slug": "large",
					"size": "1.25rem",
					"name": "Grande"
				},
				{
					"slug": "x-large",
					"size": "2.25rem",
					"name": "Título"
				}
			]
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"units": [
				"px",
				"rem",
				"%"
			]
		},
		"border": {
			"radius": true,
			"color": true,
			"style": true,
			"width": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--bg)",
			"text": "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--cuerpo)",
			"fontSize": "1rem",
			"lineHeight": "1.55"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--text)"
				},
				":hover": {
					"color": {
						"text": "#00C944"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--secondary)"
				},
				"border": {
					"radius": "10px"
				},
				"typography": {
					"fontWeight": "600"
				},
				"shadow": "0 8px 24px rgba(0, 230, 77, 0.28)",
				":hover": {
					"color": {
						"background": "#00C944",
						"text": "var(--wp--preset--color--secondary)"
					}
				}
			},
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontWeight": "700",
					"letterSpacing": "-0.02em"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontWeight": "700",
					"letterSpacing": "-0.02em"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontWeight": "700",
					"letterSpacing": "-0.02em"
				}
			}
		}
	}
}
