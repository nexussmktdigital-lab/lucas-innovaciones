# ---------------------------------------------------------------------------
# Base de datos (Neon o Supabase). Usar la cadena "pooled" para produccion.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://usuario:password@host/base?sslmode=require"

# ---------------------------------------------------------------------------
# Auth.js v5
# Generar con: openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# WooCommerce REST API v3
# Clave generada en WooCommerce > Ajustes > Avanzado > REST API (lectura/escritura)
#
# En desarrollo esto APUNTA AL STAGING y la clave se genera ahi. Con la tienda
# de produccion, una venta de prueba le descuenta stock real al negocio.
# `npm run produccion:chequear` avisa si quedo apuntando al lugar equivocado.
# ---------------------------------------------------------------------------
WOO_URL="https://lucasinnovaciones.com.ar/staging"
WOO_CONSUMER_KEY=""
WOO_CONSUMER_SECRET=""
# Secreto compartido de los webhooks de WooCommerce (firma HMAC-SHA256)
WOO_WEBHOOK_SECRET=""

# Ponelo en "true" solo si el hosting descarta la cabecera Authorization, que es
# lo que hace LiteSpeed: la credencial viaja por query string, que tambien es
# metodo oficial de WooCommerce sobre HTTPS. El chequeo de produccion lo detecta
# y lo dice cuando hace falta.
WOO_AUTH_QUERY="false"

# ---------------------------------------------------------------------------
# Terminal: prefijo del numero de venta. Una terminal por despliegue.
# ---------------------------------------------------------------------------
POS_TERMINAL="T1"

# Secreto del drenaje programado de la cola hacia WooCommerce.
# La tarea de Vercel (ver vercel.json) pega en /api/cron/sincronizar con
# `Authorization: Bearer <CRON_SECRET>`. Sin esta variable la ruta devuelve 503
# y la cola solo se mueve al confirmar una venta.
# Generar con: openssl rand -base64 32
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Ayuda para armar la ficha de un producto nuevo (OPCIONAL).
#
# Sin esto el alta de productos funciona igual, escrita a mano: lo unico que se
# pierde es el renglon que convierte «cable tipo c fox box axon 20w» en nombre,
# marca y categoria. Nunca propone precio, ni stock, ni imagenes (D15).
#
# La clave se saca en https://console.anthropic.com
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
# Opcional: por defecto claude-opus-5.
ANTHROPIC_MODELO=""
