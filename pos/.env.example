# ---------------------------------------------------------------------------
# Base de datos (Neon o Supabase). Usar la cadena "pooled" para produccion.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://usuario:password@host/base?sslmode=require"

# ---------------------------------------------------------------------------
# Auth.js v5
# Generar con: openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# WooCommerce REST API v3
# Clave generada en WooCommerce > Ajustes > Avanzado > REST API (lectura/escritura)
# ---------------------------------------------------------------------------
WOO_URL="https://lucasinnovaciones.com.ar/staging"
WOO_CONSUMER_KEY=""
WOO_CONSUMER_SECRET=""
# Secreto compartido de los webhooks de WooCommerce (firma HMAC-SHA256)
WOO_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Terminal: prefijo del numero de venta. Una terminal por despliegue.
# ---------------------------------------------------------------------------
POS_TERMINAL="T1"
